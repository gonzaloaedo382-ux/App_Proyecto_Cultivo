<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7F4"> <!-- Fondo verde muy claro, estilo natural -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Título descriptivo superior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Escanear Orquídea"
            android:textColor="#2C5E3B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Contenedor con esquinas redondeadas para la vista previa de la cámara -->
        <androidx.cardview.widget.CardView
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#E8ECE9">

            <ImageView
                android:id="@+id/imageViewEscaner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto de la planta"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <!-- Botón moderno con color corporativo y bordes redondeados -->
        <Button
            android:id="@+id/btnIrResultado"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="24dp"
            android:backgroundTint="#388E3C"
            android:enabled="false"
            android:text="Ver Resultados"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>